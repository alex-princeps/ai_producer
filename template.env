# Copy to .env and fill in. .env is never committed.

# --- Required ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_ID=your_telegram_user_id

# --- Promo code (empty = promo codes disabled) ---
PROMO_CODE=
PROMO_HOURS=24

# --- Channel for autonomous posts ---
TG_CHANNEL_ID=@your_channel
# Link to the bot in every 4th-5th channel post (off by default: the channel is the persona's showcase)
CHANNEL_BOT_CTA=
# Living columnist (needs persona_private/columnist_ru.md; all off when empty)
# Random delay before a channel post and before a follow-up, minutes
PUBLISH_JITTER_MIN=
FOLLOWUP_JITTER_MIN=
# Chance to skip a slot, as a real author sometimes does (0.03 = 3%)
SKIP_PROB_WEEKDAY=
SKIP_PROB_WEEKEND=
# Chance of a personal note instead of the Sunday evening news post
PERSONAL_SUNDAY_PROB=
# Rare typo in a channel post, fixed by editing the post 2-25 minutes later (0.07 = 7% of posts)
TYPO_PROB=
# Share of posts quoting the author's favourite poets (needs persona_private/poetry_ru.json; default 0.05)
POETRY_PROB=
# Comments under channel posts: "off" removes questions to readers and invitations to comment (default on)
CHANNEL_COMMENTS=

# --- Network (HTTP proxy for Telegram and t.me, optional) ---
PROXY_URL=

# --- Language ---
# Default UI language when the user's Telegram language is unknown (ru | en).
# The persona always answers in the language the user writes in.
APP_LANGUAGE=ru
PROMPT_FILE=prompts/system_prompt_ru.txt

# --- Knowledge base (folder with .pdf/.docx/.txt/.md; default: knowledge_base/) ---
KNOWLEDGE_DIR=knowledge_base

# --- Storage ---
DATABASE_URL=
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- QA only (qa/qa_runner.py --local) ---
TG_API_ID=
TG_API_HASH=
BOT_USERNAME=@your_dev_bot
