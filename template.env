# Copy to .env and fill in. .env is never committed.

# --- Required ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_ID=your_telegram_user_id

# --- Promo code (empty = promo codes disabled) ---
PROMO_CODE=
PROMO_HOURS=24

# --- Channel for autonomous posts ---
TG_CHANNEL_ID=@your_channel
# Link to the bot in every 4th-5th channel post (off by default: the channel is the persona's showcase)
CHANNEL_BOT_CTA=

# --- Network (HTTP proxy for Telegram and t.me, optional) ---
PROXY_URL=

# --- Language ---
# Default UI language when the user's Telegram language is unknown (ru | en).
# The persona always answers in the language the user writes in.
APP_LANGUAGE=ru
PROMPT_FILE=prompts/system_prompt_ru.txt

# --- Knowledge base (folder with .pdf/.docx/.txt/.md; default: knowledge_base/) ---
KNOWLEDGE_DIR=knowledge_base

# --- Storage ---
DATABASE_URL=
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- QA only (qa/qa_runner.py --local) ---
TG_API_ID=
TG_API_HASH=
BOT_USERNAME=@your_dev_bot
