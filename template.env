# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Обязательные ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_ID=your_telegram_user_id

# --- Промокод (пусто = промокоды отключены) ---
PROMO_CODE=
PROMO_HOURS=24

# --- Канал для публикаций ---
TG_CHANNEL_ID=@your_channel

# --- Сеть ---
PROXY_URL=

# --- Язык и промпт ---
APP_LANGUAGE=ru
PROMPT_FILE=prompts/system_prompt_ru.txt

# --- База знаний (папка с .pdf/.docx/.txt/.md; по умолчанию knowledge_base/) ---
KNOWLEDGE_DIR=knowledge_base

# --- Хранилища ---
DATABASE_URL=
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Только для QA (qa/qa_runner.py --local) ---
TG_API_ID=
TG_API_HASH=
BOT_USERNAME=@your_dev_bot
